{
  "name": "notenmeister",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Lokale, verschlüsselte Notenverwaltung für bayerische Realschulen",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "autostart:install": "bash scripts/autostart-macos.sh install",
    "autostart:uninstall": "bash scripts/autostart-macos.sh uninstall",
    "autostart:status": "bash scripts/autostart-macos.sh status"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
